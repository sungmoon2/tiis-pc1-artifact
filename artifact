"""Local-only artifact runner. A successful author run is never C8."""
import argparse,hashlib,json,mimetypes,os,platform,re,secrets,shutil,subprocess,sys,tempfile,time
from pathlib import Path
ROOT=Path(__file__).resolve().parent
sys.path.insert(0,str(ROOT/'release'));sys.path.insert(0,str(ROOT/'tests'))
from bundle import verify
from claim_contract import collect
from staging import stage
def sha(data):return hashlib.sha256(data).hexdigest()
def document(path,value):path.write_text(json.dumps(value,indent=2,sort_keys=True)+'\n')
def command(args,output=None,timeout=600):
    started=time.time()
    try:
        p=subprocess.run(list(map(str,args)),capture_output=True,text=True,timeout=timeout)
        result=dict(argv=list(map(str,args)),exit_code=p.returncode,stdout=p.stdout,stderr=p.stderr)
    except subprocess.TimeoutExpired as error:
        result=dict(argv=list(map(str,args)),exit_code=124,stdout=str(error.stdout or ''),stderr=str(error.stderr or ''))
    result.update(started_unix=started,ended_unix=time.time())
    if output is not None:document(output,result)
    return result
def require(result):
    if result['exit_code']:raise RuntimeError('command failed: '+str(result['exit_code']))
    return result['stdout'].strip()
def doctor():
    assert all(name not in os.environ for name in ['GH_TOKEN','GITHUB_TOKEN']),'candidate runtime must not inherit a GitHub token'
    os_release=dict(line.split('=',1) for line in Path('/etc/os-release').read_text().splitlines() if '=' in line)
    assert os_release.get('ID')=='ubuntu' and os_release.get('VERSION_ID','').strip('"')=='24.04'
    assert platform.machine()=='x86_64'
    versions=json.loads((ROOT/'environment/versions.lock.json').read_text())
    docker=require(command(['docker','version','--format','{{.Server.Version}}'],timeout=30))
    compose=require(command(['docker','compose','version','--short'],timeout=30)).lstrip('v')
    assert docker==versions['docker'] and compose==versions['compose'],'tool version drift'
    virt=command(['systemd-detect-virt','--vm'],timeout=10)
    guest=virt['exit_code']==0 and virt['stdout'].strip() in ['kvm','qemu']
    available=int(next(line.split()[1] for line in Path('/proc/meminfo').read_text().splitlines()
                       if line.startswith('MemAvailable:')))*1024
    assert available>(4 if guest else 9)*1024**3,'memory reserve'
    assert shutil.disk_usage(ROOT).free>20*1024**3,'disk reserve'
    assert os.cpu_count()>=4
    require(command(['zstd','--version'],timeout=10))
    require(command(['openssl','version'],timeout=10))
    info=json.loads(require(command(['docker','info','--format','{{json .}}'],timeout=30)))
    assert all(info[k] for k in ['MemoryLimit','SwapLimit','CpuCfsQuota'])
    assert info['CgroupVersion']=='2'
    if (ROOT/'.git').exists():
        assert not require(command(['git','-C',ROOT,'status','--porcelain=v1'],timeout=30)),'dirty umbrella'
    return dict(status='PASS',os='Ubuntu 24.04',architecture='x86_64',kernel=platform.release(),
      docker=docker,compose=compose,python=platform.python_version(),cpu_count=os.cpu_count(),
      available_memory_bytes=available,vm_detected=guest,virtualization=virt['stdout'].strip(),
      published_application_ports=[],C8='C8_PENDING_INDEPENDENT_REPRODUCTION')
def state_path(output):return output/'STATE.private.json'
def read_state(output):return json.loads(state_path(output).read_text())
def write_state(output,state):document(state_path(output),state)
def preflight_output(output):
    """Require real direct execution before any Docker or setup work."""
    receipt=dict(status='FAIL',output_root=str(output),probe=None)
    probe=None
    try:
        receipt['mount']=command(['findmnt','-T',output,'-o','TARGET,SOURCE,FSTYPE,OPTIONS'],timeout=10)
        require(receipt['mount'])
        fd,name=tempfile.mkstemp(prefix='.tiis-exec-probe-',dir=output)
        probe=Path(name)
        with os.fdopen(fd,'w') as stream:stream.write('#!/bin/sh\nexit 0\n')
        probe.chmod(0o700)
        receipt['probe']=str(probe)
        receipt['probe_mode']=oct(probe.stat().st_mode & 0o777)
        # No shell/interpreter wrapper: mode bits alone cannot detect noexec.
        receipt['direct_exec']=command([probe],timeout=10)
        require(receipt['direct_exec'])
        receipt['status']='PASS'
    except Exception as error:
        receipt['error']=str(error)
        receipt['errno']=getattr(error,'errno',None)
    finally:
        if probe is not None:
            try:probe.unlink();receipt['probe_cleanup']='PASS'
            except OSError as error:
                receipt['status']='FAIL';receipt['probe_cleanup']=str(error)
        else:receipt['probe_cleanup']='NOT_CREATED'
        document(output/'private/OUTPUT_PREFLIGHT.json',receipt)
    if receipt['status']!='PASS':
        mount=receipt.get('mount',{})
        raise RuntimeError('Output root must support direct executable files. '
          'Choose a NEW private path on an exec-capable ordinary filesystem, '
          'for example /var/tmp/tiis-pc1-<run-id>; keep publishable staging separate. '
          'No image pull or network startup was attempted. '
          'findmnt TARGET/SOURCE/FSTYPE/OPTIONS: '+mount.get('stdout','unavailable').strip()+
          '; '+mount.get('stderr','').strip()+'; '+receipt.get('error','probe cleanup failed'))
    return receipt
def setup(args):
    output=args.output.resolve()
    assert output!=ROOT and ROOT not in output.parents and output not in ROOT.parents,'output must be outside source'
    output.mkdir(mode=0o700,parents=False,exist_ok=False)
    (output/'private').mkdir(mode=0o700)
    state=dict(namespace='tiispc1-'+secrets.token_hex(6),phases={},install_names=[])
    write_state(output,state)
    try:
        preflight_output(output)
        document(output/'private/ENVIRONMENT.json',doctor())
        lock=json.loads((ROOT/'components.lock.json').read_text())
        receipt=verify(args.rc_input_bundle,lock,output/'components')
        document(output/'private/BUNDLE_VERIFICATION.json',receipt)
        runtime=output/'runtime';runtime.mkdir(mode=0o700)
        for name in ['api','web','chaincode','network']:
            shutil.copytree(output/('components/tiis-pc1-'+name),runtime/name)
        shutil.copytree(ROOT,runtime/'artifact',ignore=shutil.ignore_patterns('.git','__pycache__','*.pyc'))
        images=json.loads((ROOT/'environment/images.lock.json').read_text())
        config=output/'private/docker-config';config.mkdir()
        for image in images:
            require(command(['docker','--config',config,'pull',image['reference']],
              output/('private/pull-'+image['role']+'.json')))
            inspected=json.loads(require(command(['docker','image','inspect',image['reference']],
              output/('private/image-'+image['role']+'.json'))))[0]
            assert image['reference'] in inspected['RepoDigests'] and inspected['Architecture']=='amd64'
        node=next(i['reference'] for i in images if i['role']=='node')
        for name in ['api','web','chaincode']:
            resource=state['namespace']+'-install-'+name
            assert not require(command(['docker','ps','-aq','--filter','name=^/'+resource+'$']))
            state['install_names'].append(resource);write_state(output,state)
            require(command(['docker','run','--rm','--name',resource,'--label','tiis.run='+state['namespace'],
              '--memory','768m','--memory-swap','768m','--cpus','1','--pids-limit','128',
              '--cap-drop','ALL','--security-opt','no-new-privileges','--user',str(os.getuid())+':'+str(os.getgid()),
              '-v',str(runtime/name)+':/work','-w','/work',node,'npm','ci','--ignore-scripts',
              '--no-audit','--no-fund','--cache','/tmp/npm-cache'],output/('private/npm-'+name+'.json')))
        require(command(['python3',runtime/'chaincode/package-service.py',runtime/'evidence.tgz'],
          output/'private/CHAINCODE_PACKAGE.json'))
        state['phases']['setup']='PASS'
    except Exception:
        state['phases']['setup']='FAIL';raise
    finally:write_state(output,state)
def phase(args,name):
    output=args.output.resolve();state=read_state(output);runtime=output/'runtime'
    if name=='start':assert state['phases'].get('setup')=='PASS'
    if name=='test':assert state['phases'].get('start')=='PASS'
    directory=output/'private'/name
    try:
        if (runtime/'RESOURCE_REGISTRY.private.json').exists() or name=='start':
            result=command(['python3',runtime/'network/bootstrap.py',runtime,ROOT/'environment/images.lock.json',
              directory,state['namespace'],name],output/('private/'+name+'-command.json'),timeout=900)
            require(result)
        elif name in ['collect','stop']:
            directory.mkdir();document(directory/'RESULT.json',dict(status='PASS',note='NETWORK_NOT_STARTED'))
        else:raise RuntimeError('network registry absent')
        if name=='test':
            collect(runtime,output/'private/compare')
        state['phases'][name]='PASS'
    except Exception:
        state['phases'][name]='FAIL';raise
    finally:write_state(output,state)
def cleanup_installs(output):
    state=read_state(output)
    try:
        for name in state['install_names']:
            cid=require(command(['docker','ps','-aq','--filter','name=^/'+name+'$']))
            if not cid:continue
            inspected=json.loads(require(command(['docker','inspect',cid])))[0]
            assert inspected['Config']['Labels'].get('tiis.run')==state['namespace']
            require(command(['docker','rm','-f','-v',cid]))
        state['phases']['install_cleanup']='PASS'
    except Exception:
        state['phases']['install_cleanup']='FAIL';raise
    finally:write_state(output,state)
def redact(text,runtime,output,artifact_origin=None):
    def sanitize(value):
        if isinstance(value,list):return [sanitize(v) for v in value]
        if not isinstance(value,dict):return value
        value={k:sanitize(v) for k,v in value.items()}
        if value.get('argv')==['docker','volume','ls','-q'] and 'stdout' in value:
            original=value['stdout']
            value['stdout_sha256']=sha(original.encode())
            value['stdout_line_count']=len(original.splitlines())
            value['stdout']='<PRIVATE_RESOURCE_INVENTORY_REDACTED>'
            value['redaction_reason']='Global host volume names are private; owned-resource teardown result is retained separately'
        return value
    try:text=json.dumps(sanitize(json.loads(text)),indent=2,sort_keys=True)+'\n'
    except json.JSONDecodeError:pass
    replacements=[(str(output),'<RUN_ROOT>'),(str(ROOT),'<ARTIFACT_ROOT>'),('/var/lib/docker','<DOCKER_DATA_ROOT>')]
    if artifact_origin:replacements.append((str(artifact_origin),'<ARTIFACT_ROOT>'))
    password=runtime/'database-password'
    if password.exists():replacements.append((password.read_text(),'<SYNTHETIC_SECRET_REDACTED>'))
    control=runtime/'test-control.json'
    if control.exists():
        cfg=json.loads(control.read_text())
        replacements += [(cfg['control'],'<SYNTHETIC_SECRET_REDACTED>')]
        replacements += [(value,'<SYNTHETIC_SECRET_REDACTED>') for value in cfg['sources'].values()]
    for before,after in replacements:
        if before:text=text.replace(before,after)
    text=re.sub(r'172\.(?:1[6-9]|2[0-9]|3[01])(?:\.[0-9]{1,3}){2}','<SYNTHETIC_BRIDGE_IP>',text)
    if re.search(r'-----BEGIN (?:EC |RSA )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}',text):
        raise ValueError('secret material in evidence')
    return text
def finalize(args):
    output=args.output.resolve();state=read_state(output);runtime=output/'runtime'
    public=output/'evidence';public.mkdir(exist_ok=False)
    entries=[]
    sources=[p for p in (output/'private').rglob('*') if p.is_file() and
      (p.name.endswith('-command.json') or p.name.startswith('LOG-') or
       p.parent.name=='compare' or p.name in ['COMMANDS.private.json','ENVIRONMENT.json','BUNDLE_VERIFICATION.json','CHAINCODE_PACKAGE.json','TEARDOWN.json'])]
    sources += [runtime/name for name in ['DEVELOPMENT_CASES.json','HTTP_CASES.json','PROJECTION_SNAPSHOT.json','FINAL_PROJECTION_SNAPSHOT.json'] if (runtime/name).exists()]
    for number,source in enumerate(sorted(sources)):
        name=f'raw/{number:03}-'+source.name.replace('.private','')
        target=public/name;target.parent.mkdir(exist_ok=True)
        raw=source.read_bytes();clean=redact(raw.decode('utf-8'),runtime,Path(state.get('raw_output_origin',output)),state.get('raw_artifact_origin')).encode()
        target.write_bytes(clean)
        entries.append(dict(path=name,raw_sha256=sha(raw),export_sha256=sha(clean),
          redacted=raw!=clean,raw_preserved_privately=True))
    document(public/'EXPORT_PROVENANCE.json',entries)
    success=all(state['phases'].get(name)=='PASS' for name in ['setup','start','test','collect','stop','install_cleanup'])
    document(public/'RUN_RESULT.json',dict(overall='PASS' if success else 'FAIL',phases=state['phases'],
      provenance='NEW_CLEAN_AUTHOR_EXECUTION',C8='C8_PENDING_INDEPENDENT_REPRODUCTION',
      core_counts={'C1':[15,12,5,2],'C2':14,'C3':9,'C4':36},
      separate_regressions=['C3 audit-write failure','C3 session revocation','C4 process SIGKILL'],
      count_values_are_contract_not_measurement=True))
    document(public/'FINALIZATION.json',dict(status='PREPARED_FOR_DIRECT_READBACK',
      raw_secret_material_excluded=True,private_raw_retained=True))
    payloads=sorted(p for p in public.rglob('*') if p.is_file())
    manifest='path\tmedia_type\tbytes\tsha256\tsensitivity\n'+''.join(
      p.relative_to(public).as_posix()+'\t'+(mimetypes.guess_type(p.name)[0] or 'application/octet-stream')+
      '\t'+str(p.stat().st_size)+'\t'+sha(p.read_bytes())+'\tSYNTHETIC_REDACTED_EXPORT\n' for p in payloads)
    (public/'MANIFEST.tsv').write_text(manifest)
    sums=''.join(sha(p.read_bytes())+'  '+p.relative_to(public).as_posix()+'\n'
      for p in sorted(payloads+[public/'MANIFEST.tsv']))
    (public/'SHA256SUMS.txt').write_text(sums)
    # Resolve relative paths against this exact newly generated package, not caller CWD.
    for line in sums.splitlines():
        expected,name=line.split('  ',1);assert sha((public/name).read_bytes())==expected
    receipt=dict(status='PASS',files=[dict(path=p.relative_to(public).as_posix(),bytes=p.stat().st_size,
      sha256=sha(p.read_bytes())) for p in sorted(public.rglob('*')) if p.is_file()])
    document(output/'READBACK.json',receipt)
    return success
def main():
    parser=argparse.ArgumentParser()
    parser.add_argument('command',choices=['doctor','setup','start','test','collect-evidence','stop','finalize-evidence','reproduce','verify-rc-input-bundle','stage-evidence'])
    parser.add_argument('--input',type=Path)
    parser.add_argument('--publishable-output',type=Path,
      help='new staging path separate from private runtime, e.g. /var/tmp/tiis-pc1-<run-id>-publishable')
    parser.add_argument('--output','--evidence',type=Path,default=os.environ.get('TIIS_ARTIFACT_RUN'),
      help='new private exec-capable path outside source, e.g. /var/tmp/tiis-pc1-<run-id>; '
        'or TIIS_ARTIFACT_RUN; setup verifies findmnt and a direct executable probe before Docker')
    parser.add_argument('--rc-input-bundle','--bundle',dest='rc_input_bundle',type=Path,default=os.environ.get('TIIS_RC_INPUT_BUNDLE'))
    parser.add_argument('--lock',type=Path,default=ROOT/'components.lock.json')
    parser.add_argument('--claims',default='C1,C2,C3,C4')
    parser.add_argument('--phase',choices=['pre-teardown'])
    args=parser.parse_args()
    if args.lock!=(ROOT/'components.lock.json'):
        assert args.lock.read_bytes()==(ROOT/'components.lock.json').read_bytes(),'alternate lock not accepted'
    if args.command=='doctor':print(json.dumps(doctor(),indent=2));return 0
    if args.command=='stage-evidence':
        print(json.dumps(stage(args.input,args.publishable_output),indent=2));return 0
    if args.command=='verify-rc-input-bundle':
        print(json.dumps(verify(args.rc_input_bundle,json.loads((ROOT/'components.lock.json').read_text())),indent=2));return 0
    assert args.output and args.claims=='C1,C2,C3,C4'
    if args.command=='reproduce':
        failures=[]
        try:
            setup(args);phase(args,'start');phase(args,'test')
        except Exception as error:failures.append(str(error))
        finally:
            if state_path(args.output).exists():
                for action in ['collect','stop']:
                    try:phase(args,action)
                    except Exception as error:failures.append(action+': '+str(error))
                try:cleanup_installs(args.output)
                except Exception as error:failures.append('install cleanup: '+str(error))
                try:ok=finalize(args)
                except Exception as error:failures.append('finalization: '+str(error));ok=False
            else:ok=False
        print(json.dumps(dict(status='PASS' if ok and not failures else 'FAIL',failures=failures),indent=2))
        return 0 if ok and not failures else 4
    if args.command=='setup':setup(args)
    elif args.command=='finalize-evidence':return 0 if finalize(args) else 5
    elif args.command=='stop':phase(args,'stop');cleanup_installs(args.output)
    else:phase(args,{'collect-evidence':'collect'}.get(args.command,args.command))
    return 0
if __name__=='__main__':
    try:sys.exit(main())
    except Exception as error:print(json.dumps(dict(status='FAIL',error=str(error))));sys.exit(2)
